freyja demix --eps 0.01 --covcut 10 --pathogen MEASLESN450 --depthcutoff 0 /mnt/miniwdl_task_container/work/_miniwdl_inputs/0/2503120184-braz_variants.tsv /mnt/miniwdl_task_container/work/_miniwdl_inputs/0/2503120184-braz_depth.tsv --output 2503120184-braz_demixed.tsv
