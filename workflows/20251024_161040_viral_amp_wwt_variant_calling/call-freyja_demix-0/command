
 if [ -f "/mnt/miniwdl_task_container/work/_miniwdl_inputs/0/MEASLESN450_lineages.yml" ]; then
    echo "Installing custom lineages file for MEASLESN450"
    cp /mnt/miniwdl_task_container/work/_miniwdl_inputs/0/MEASLESN450_lineages.yml /opt/conda/envs/freyja-env/lib/python3.12/site-packages/freyja/data/MEASLESN450_lineages.yml
